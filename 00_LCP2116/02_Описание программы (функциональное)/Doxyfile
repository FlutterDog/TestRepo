# Doxyfile for LCP Basic Diagnostic Firmware
# Рабочий каталог: корень проекта, например C:\DoxygenFolder

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "LCP Basic Diagnostic Firmware"
PROJECT_BRIEF          = "Базовая диагностическая прошивка контроллера LCP"
PROJECT_NUMBER         = "0.16.3"
OUTPUT_LANGUAGE        = Russian

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_TEXT_DIRECTION  = None

INPUT                  = README.md \
                         main.cpp \
                         app \
                         board \
                         hal \
                         platform \
                         libs/lcp_sd_storage

INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.cpp \
                         *.hpp \
                         *.c \
                         *.h \
                         *.md

RECURSIVE              = YES

EXCLUDE                = libs/SAM_USB \
                         Device_Startup \
                         docs/doxygen \
                         Debug \
                         Release \
                         .vs

EXCLUDE_PATTERNS       = */.vs/* \
                         */Debug/* \
                         */Release/* \
                         */build/* \
                         */docs/doxygen/* \
                         */libs/SAM_USB/* \
                         */Device_Startup/* \
                         *.atsuo \
                         *.user \
                         *.suo

USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO

CASE_SENSE_NAMES       = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        =
SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
EXTENSION_MAPPING      =

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

INCLUDE_PATH           = app \
                         app/diagnostics \
                         board \
                         hal \
                         platform \
                         libs/lcp_sd_storage

PREDEFINED             = __SAM3X8E__=1 \
                         DOXYGEN=1 \
                         HIGH=1U \
                         LOW=0U \
                         INPUT=0U \
                         OUTPUT=1U \
                         INPUT_PULLUP=2U \
                         SERIAL_8N1=0U \
                         SERIAL_8O1=1U \
                         SERIAL_8E1=2U \
                         DEC=10U \
                         HEX=16U \
                         OCT=8U \
                         BIN=2U

SKIP_FUNCTION_MACROS   = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_DIAGRAMS         = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = doxygen_warnings.log

QUIET                  = NO
